<%- include('../partials/header') %>

<section class="page-header">
  <div class="container">
    <h1>Training Services</h1>
    <p>Professional dog training programs for every stage of your dog's life</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="services-grid">
      <div class="service-card-full">
        <h2>Puppy Basics (8 weeks - 6 months)</h2>
        <p>Build a strong foundation with socialization, basic commands (sit, down, stay), house training tips, and bite inhibition.</p>
        <ul>
          <li>6-week group course</li>
          <li>Max 6 puppies per class</li>
          <li>Saturday mornings, 10am</li>
          <li>Includes training manual</li>
        </ul>
        <div class="service-footer">
          <span class="price">$199</span>
          <a href="/training/book/puppy-basics" class="btn btn-primary">Book Now</a>
        </div>
      </div>

      <div class="service-card-full">
        <h2>Basic Obedience (6+ months)</h2>
        <p>Comprehensive obedience training covering heel, stay, reliable recall, leash manners, and impulse control.</p>
        <ul>
          <li>8-week group course</li>
          <li>Max 8 dogs per class</li>
          <li>Tuesday & Thursday evenings, 6pm</li>
          <li>Graduation certificate included</li>
        </ul>
        <div class="service-footer">
          <span class="price">$249</span>
          <a href="/training/book/basic-obedience" class="btn btn-primary">Book Now</a>
        </div>
      </div>

      <div class="service-card-full">
        <h2>Advanced Obedience</h2>
        <p>Off-leash reliability, distance commands, distraction proofing, and canine good citizen preparation.</p>
        <ul>
          <li>8-week group course</li>
          <li>Prerequisite: Basic Obedience</li>
          <li>Wednesday evenings, 6pm</li>
          <li>CGC test prep included</li>
        </ul>
        <div class="service-footer">
          <span class="price">$299</span>
          <a href="/training/book/advanced-obedience" class="btn btn-primary">Book Now</a>
        </div>
      </div>

      <div class="service-card-full">
        <h2>Private Training Sessions</h2>
        <p>One-on-one sessions tailored to your dog's specific needs. Ideal for behavioral issues, reactivity, or personalized goals.</p>
        <ul>
          <li>60-minute sessions</li>
          <li>Flexible scheduling</li>
          <li>At our facility or your home</li>
          <li>Written training plan provided</li>
        </ul>
        <div class="service-footer">
          <span class="price">$85 / session</span>
          <a href="/training/book/private" class="btn btn-primary">Book Now</a>
        </div>
      </div>

      <div class="service-card-full">
        <h2>Board & Train</h2>
        <p>Your dog stays with us for intensive, immersive training. Daily sessions with progress updates sent to you.</p>
        <ul>
          <li>2-week or 4-week programs</li>
          <li>Daily training + socialization</li>
          <li>Video updates</li>
          <li>Transfer sessions included</li>
        </ul>
        <div class="service-footer">
          <span class="price">From $1,200</span>
          <a href="/training/book/board-train" class="btn btn-primary">Book Now</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">Our Trainers</h2>
    <div class="trainers-grid">
      <div class="trainer-card">
        <h3>Maria Gonzalez</h3>
        <p class="trainer-title">Head Trainer, CPDT-KA</p>
        <p>15+ years of experience specializing in positive reinforcement methods. Certified through the CCPDT.</p>
      </div>
      <div class="trainer-card">
        <h3>David Chen</h3>
        <p class="trainer-title">Senior Trainer</p>
        <p>Former service dog trainer with expertise in obedience, agility, and behavioral modification.</p>
      </div>
      <div class="trainer-card">
        <h3>Sarah Williams</h3>
        <p class="trainer-title">Puppy Specialist</p>
        <p>Dedicated to early development and socialization. Fear-free certified professional.</p>
      </div>
    </div>
  </div>
</section>

