{
  "name": "paco-dogshop",
  "version": "1.0.0",
  "description": "Sample dog accessories and training services e-commerce site for educational purposes",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "db:migrate": "knex migrate:latest --knexfile src/config/knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile src/config/knexfile.js",
    "db:seed": "knex seed:run --knexfile src/config/knexfile.js",
    "lint": "eslint src/",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify"
  },
  "keywords": [
    "dog-shop",
    "e-commerce",
    "training-services",
    "educational",
    "express",
    "nodejs"
  ],
  "author": "Jose Pineda Delgado",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-session-knex": "^4.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.7",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.0"
  }
}
